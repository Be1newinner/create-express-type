{
  "name": "create-express-type",
  "version": "3.0.0",
  "description": "Scaffold a production-ready TypeScript + Express.js project in seconds.",
  "main": "dist/cli.js",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.cli.json",
    "dev": "tsc -p tsconfig.cli.json --watch",
    "prepublishOnly": "npm run build",
    "test": "echo \"No tests for CLI yet\" && exit 0"
  },
  "bin": {
    "create-express-type": "dist/cli.js"
  },
  "keywords": [
    "express",
    "typescript",
    "express-type",
    "scaffold",
    "boilerplate",
    "node",
    "backend",
    "api",
    "server",
    "starter",
    "create-app"
  ],
  "homepage": "https://github.com/Be1newinner/create-express-type",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Be1newinner/create-express-type.git"
  },
  "author": "be1newinner",
  "license": "ISC",
  "dependencies": {
    "@clack/prompts": "^0.9.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  },
  "files": [
    "dist/cli.js",
    "packages/express-type",
    "packages/overlays",
    "!packages/**/node_modules",
    "!packages/**/dist",
    "!packages/**/coverage",
    "!packages/**/.env",
    "!packages/express-type/package-lock.json"
  ]
}
