# ─── Server ───────────────────────────────────────────────────────────────────
PORT=8005
NODE_ENV=development

# ─── Security — JWT ───────────────────────────────────────────────────────────
# REQUIRED: Must be at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-random-32-plus-character-secret-string
JWT_EXPIRES_IN=7d

# ─── Security — CORS ──────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (no spaces after commas)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── Database (uncomment and fill in when you add a database) ─────────────────
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mydb

# ─── Redis (uncomment when adding Redis caching) ─────────────────────────────
# REDIS_URL=redis://localhost:6379
